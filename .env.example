# ─────────────────────────────────────────────────────────
# KryzOx Technologies — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ─────────────────────────────────────────────────────────

# Port d'écoute du serveur (Hostinger le définit automatiquement)
# Ne pas modifier en production Hostinger — laisser commenté
# PORT=3000

# ── Mailgun (envoi d'emails depuis le formulaire de contact) ──
# Obtenez votre clé sur : https://app.mailgun.com/settings/api_keys
MAILGUN_API_KEY=your-mailgun-api-key-here

# Votre domaine vérifié dans Mailgun (ex: mg.kryzotec.com)
MAILGUN_DOMAIN=mg.kryzotec.com
